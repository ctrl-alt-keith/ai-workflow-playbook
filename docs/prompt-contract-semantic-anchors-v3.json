{
  "anchor_version": "3.0.0",
  "artifact_type": "prompt_contract_semantic_anchors",
  "artifact_classes": [
    "immutable_semantic_prompt_contract",
    "source_manifest",
    "hydrated_context",
    "rendered_prompt",
    "attempt_execution_receipt",
    "checkpoint"
  ],
  "authority_reference_requirements": [
    "approval_source_identity",
    "startup_state_or_durable_receipt_identity",
    "asserted_permitted_action",
    "authority_assertion_non_authoritative"
  ],
  "canonicalization": {
    "digest_algorithm": "SHA-256",
    "digest_text_form": "sha256:<64 lowercase hex characters>",
    "encoding": "UTF-8",
    "input_profile": "I-JSON",
    "no_bom": true,
    "scheme": "RFC8785-JCS",
    "unicode_normalization": "none",
    "version": 1
  },
  "compatibility_rules": [
    "schema_major_exact_match",
    "canonicalization_major_exact_match",
    "compatibility_major_exact_match",
    "semantic_sources_within_declared_range",
    "no_implicit_major_adoption",
    "required_capabilities_and_guarantees_preserved",
    "implementation_compatibility_unambiguous_and_validated"
  ],
  "contract_receipt_boundary": {
    "contract_created_and_hashed_before": [
      "source_hydration",
      "prompt_rendering"
    ],
    "contract_may_include": [
      "contract_identity",
      "semantic_version",
      "schema_requirements",
      "canonicalization_requirements",
      "purpose_phase_mode",
      "compatibility_constraints",
      "source_ownership_and_reference_requirements",
      "authority_references_and_non_authoritative_asserted_action",
      "required_capabilities_and_reasoning_class",
      "validation_profile_and_validator_requirements",
      "hydrator_adapter_renderer_requirements",
      "ordered_transport_policy",
      "required_outputs_and_expected_evidence",
      "mandatory_fail_closed_conditions"
    ],
    "contract_must_not_include": [
      "contract_digest",
      "selected_source_manifest_digest",
      "hydrated_context_digest",
      "rendered_prompt_digest",
      "actual_transport_selection",
      "validation_results",
      "execution_results",
      "checkpoint_output",
      "runtime_safety_policy_identity"
    ],
    "receipt_is_append_only": true,
    "receipt_references_contract_digest": true,
    "receipt_records_selected_and_derived_identities": true
  },
  "fresh_selection_rules": {
    "immutable_for_attempt": [
      "selected_source_blobs",
      "hydrator",
      "representation_adapter",
      "renderer",
      "validation_profile",
      "validator_identity",
      "model_recommendation_metadata",
      "transport_policy_inputs"
    ],
    "no_input_moves_during_attempt": true,
    "select_once_before_hydration": true
  },
  "invariants": {
    "no_authority": true,
    "no_orchestration": true,
    "no_state_transition": true,
    "prompt_text_is_not_authorization": true,
    "validation_is_not_authorization": true
  },
  "issue_owned_durable_handoff_profile": {
    "admission_conditions": [
      "substantial_output",
      "exact_identity_required_for_authorized_dependency",
      "regeneration_or_chat_only_retention_weakens_dependency",
      "storage_visibility_privacy_and_retention_affirmative",
      "no_secrets_credentials_prohibited_or_unrelated_content",
      "issue_and_natural_owner_unambiguous"
    ],
    "coordination_states": [
      "PRESERVED",
      "DELIVERED",
      "ACCEPTED",
      "STARTED",
      "COMPLETED",
      "FAILED",
      "UNKNOWN"
    ],
    "delivery_routes": [
      "qualified_direct_durable_object_retrieval",
      "private_executor_owned_attempt_local_exact_retrieval"
    ],
    "durable_capture": {
      "absent_create": true,
      "autorename": false,
      "containment_verification_required": true,
      "corrections_create_new_immutable_version": true,
      "exact_byte_size_and_sha256_required": true,
      "issue_owned_destination_selected_by_storage_contract": true,
      "no_overwrite": true,
      "one_writer": true,
      "provider_content_hash_recorded_when_available": true,
      "provider_object_identity_required": true,
      "provider_revision_recorded_when_available": true,
      "provider_revision_unavailability_recorded_when_not_exposed": true,
      "provider_revision_must_not_be_fabricated": true
    },
    "integrity_verification": {
      "allowed_routes": [
        "exact_raw_provider_readback",
        "qualified_local_bytes_provider_checksum"
      ],
      "exact_raw_provider_readback": {
        "exact_bytes_size_format_digest_and_containment_required": true
      },
      "qualified_local_bytes_provider_checksum": {
        "authoritative_stored_size_matches_frozen_local_byte_length": true,
        "created_and_reobserved_provider_object_identity_matches": true,
        "provider_checksum_algorithm_officially_documented_for_local_to_stored_equality": true,
        "provider_checksum_computed_from_same_frozen_local_bytes": true,
        "provider_reported_checksum_matches_local_provider_checksum": true,
        "raw_provider_readback_required_after_qualified_match": false,
        "whole_file_sha256_kept_distinct_from_provider_checksum": true
      },
      "unavailable_incomplete_ambiguous_or_unqualified_route_fails_closed": true
    },
    "admission_fail_closed_triggers": [
      "storage_visibility_privacy_or_retention_not_affirmative",
      "destination_collision_or_identity_mismatch",
      "prohibited_content_detected",
      "issue_or_natural_owner_ambiguous",
      "exact_byte_preservation_uncertain"
    ],
    "evidence_identities": [
      "durable_rendered_prompt",
      "producing_receipt",
      "delivery_operation",
      "executor_acknowledgement",
      "executor_attempt",
      "attempt_receipt",
      "executor_output",
      "human_disposition"
    ],
    "prohibited_surfaces_and_claims": [
      "separate_durable_exchange_root",
      "mutable_prompt_alias",
      "shadow_durable_transport_copy",
      "copy_paste_as_exact_byte_route"
    ],
    "recovery_chain": [
      "planning_decision",
      "durable_rendered_prompt_identity",
      "delivery_evidence",
      "executor_attempt_receipt",
      "executor_output_identity",
      "fresh_current_source_retrieval"
    ],
    "transport_cleanup": {
      "delete_durable_prompt": false,
      "remove_private_attempt_local_copy_after_dependency_and_evidence_end": true,
      "requires_recurring_cleanup_automation": false
    },
    "delivery_envelope": {
      "external_to_referenced_rendered_prompt_bytes_and_digest": true,
      "rendered_prompt_frozen_before_final_identity_derivation": true,
      "placeholder_self_identity_in_rendered_prompt_prohibited": true,
      "records_after_freeze": [
        "exact_byte_size",
        "whole_file_sha256",
        "provider_object_identity",
        "provider_revision_when_available_or_explicit_unavailability",
        "selected_delivery_route"
      ]
    },
    "producing_receipt": {
      "exactly_one_per_admitted_artifact_write": true,
      "exact_reconciliation_reuses_or_repairs_to_exactly_one_receipt": true,
      "distinct_from": [
        "durable_rendered_prompt",
        "delivery_operation",
        "executor_acknowledgement",
        "attempt_receipt",
        "executor_output",
        "human_disposition"
      ]
    },
    "exact_reconciliation": {
      "limited_to_prior_ambiguous_absent_create_result": true,
      "same_frozen_target_and_provider_object_identity_required": true,
      "raw_readback_exact_match_required": true,
      "no_second_write_proven": true,
      "preexisting_object_without_these_facts_is_collision": true
    },
    "coordination_state_requirements": {
      "PRESERVED": [
        "one_durable_object_created_or_prior_ambiguous_absent_create_reconciled_exact",
        "exact_reconciliation_requires_same_target_object_identity_and_no_second_write",
        "created_object_integrity_verified_by_exact_raw_readback_or_qualified_local_bytes_provider_checksum",
        "ambiguous_absent_create_reconciliation_still_requires_raw_readback"
      ],
      "DELIVERED": [
        "one_delivery_operation_identifies_exact_rendered_prompt",
        "selected_route",
        "intended_target",
        "observed_delivery_result"
      ],
      "ACCEPTED": [
        "receiving_executor_explicitly_acknowledges_prompt_identity",
        "delivery_alone_insufficient"
      ],
      "STARTED": [
        "one_unique_executor_attempt_actually_began",
        "acknowledgement_alone_insufficient"
      ],
      "COMPLETED": [
        "terminal_successful_execution_result",
        "output_identity_recorded_when_applicable",
        "does_not_imply_correctness_human_acceptance_merge_release_or_adoption"
      ],
      "FAILED": [
        "bounded_failure_class",
        "attempt_or_delivery_identity",
        "last_verified_state"
      ],
      "UNKNOWN": [
        "required_evidence_unavailable",
        "no_later_state_inferred"
      ]
    }
  },
  "mandatory_fail_closed_triggers": [
    "missing_required_identity_or_evidence",
    "contract_receipt_boundary_violation",
    "derived_digest_in_contract",
    "digest_or_exact_byte_mismatch",
    "schema_major_mismatch",
    "canonicalization_major_mismatch",
    "compatibility_major_mismatch",
    "invalid_unicode_or_encoding",
    "non_i_json_or_incompatible_number",
    "source_missing_stale_ambiguous_duplicate_conflicting_or_out_of_range",
    "validator_profile_or_checkpoint_lineage_mismatch",
    "replay_dependency_unavailable_or_selection_drift",
    "mandatory_executor_capability_unavailable",
    "live_authority_stale_consumed_expired_revoked_ambiguous_or_mismatched",
    "transport_changes_bytes_or_weakens_invariants",
    "lifecycle_mutation_authorization_or_orchestration_attempt",
    "deterministic_derivation_disagreement"
  ],
  "ownership_precedence": [
    "current_system_and_human_safety_constraints",
    "human_intent_task_ledger_and_explicit_authorization",
    "durable_lifecycle_state_accepted_identities_and_live_authority",
    "shared_playbook_semantics",
    "repository_local_instructions_and_sources",
    "bounded_phase_profile",
    "representation_adapter",
    "renderer",
    "transport"
  ],
  "reasoning_classes": [
    "light",
    "medium",
    "high"
  ],
  "required_identity_names": [
    "schema_version",
    "canonicalization_scheme",
    "canonicalization_version",
    "semantic_prompt_contract",
    "validation_profile",
    "validator_identity",
    "source_manifest",
    "authority_source_and_durable_lineage",
    "hydrator",
    "hydrated_context",
    "representation_adapter",
    "renderer",
    "rendered_prompt",
    "transport_policy",
    "transport_selection",
    "attempt",
    "checkpoint",
    "runtime_safety_policy_observation"
  ],
  "rendered_prompt_bytes": {
    "canonicalization": "not-jcs",
    "digest_algorithm": "SHA-256",
    "encoding": "UTF-8",
    "final_newline_rule": "explicitly_declared_by_renderer",
    "line_endings": "LF",
    "no_bom": true
  },
  "replay_pinned_identities": [
    "semantic_contract_digest_and_version",
    "schema_identity",
    "canonicalization_identity",
    "source_bytes_and_references",
    "source_manifest_digest",
    "hydrated_context_digest",
    "hydrator_identity",
    "representation_adapter_identity",
    "renderer_identity",
    "validation_profile",
    "validator_identity",
    "rendered_prompt_bytes",
    "ordered_transport_policy",
    "attempt_and_checkpoint_lineage",
    "durable_state_or_receipt_lineage",
    "authority_source_reference_and_asserted_action"
  ],
  "transport_invariants": {
    "fallback_changes_delivery_only": true,
    "must_preserve": [
      "prompt_bytes",
      "contract_identity",
      "validation",
      "provenance",
      "evidence",
      "authority_handling",
      "required_capabilities"
    ],
    "selection_rule": "first_currently_available_permitted_route_in_declared_order"
  },
  "versioning_categories": {
    "major": [
      "authority",
      "lifecycle",
      "guarantees",
      "replay",
      "compatibility_major",
      "fallback_semantics"
    ],
    "minor": [
      "executor_visible_imperative_instruction_change",
      "new_required_behavior",
      "compatible_semantic_addition"
    ],
    "patch": [
      "strictly_non_behavioral_executor_invisible_change"
    ]
  },
  "compatibility_major": 3,
  "supersession": {
    "supersedes_for_new_compatible_selection": "prompt-contract-semantic-anchors-v2.json",
    "historical_consumers_remain_pinned_to_recorded_major": true,
    "implicit_major_adoption_prohibited": true
  }
}
