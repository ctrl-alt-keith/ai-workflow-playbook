{
  "anchor_version": "1.0.0",
  "artifact_type": "prompt_contract_semantic_anchors",
  "artifact_classes": [
    "immutable_semantic_prompt_contract",
    "source_manifest",
    "hydrated_context",
    "rendered_prompt",
    "attempt_execution_receipt",
    "checkpoint"
  ],
  "authority_reference_requirements": [
    "approval_source_identity",
    "startup_state_or_durable_receipt_identity",
    "asserted_permitted_action",
    "authority_assertion_non_authoritative"
  ],
  "canonicalization": {
    "digest_algorithm": "SHA-256",
    "digest_text_form": "sha256:<64 lowercase hex characters>",
    "encoding": "UTF-8",
    "input_profile": "I-JSON",
    "no_bom": true,
    "scheme": "RFC8785-JCS",
    "unicode_normalization": "none",
    "version": 1
  },
  "compatibility_rules": [
    "schema_major_exact_match",
    "canonicalization_major_exact_match",
    "semantic_sources_within_declared_range",
    "no_implicit_major_adoption",
    "required_capabilities_and_guarantees_preserved",
    "implementation_compatibility_unambiguous_and_validated"
  ],
  "contract_receipt_boundary": {
    "contract_created_and_hashed_before": [
      "source_hydration",
      "prompt_rendering"
    ],
    "contract_may_include": [
      "contract_identity",
      "semantic_version",
      "schema_requirements",
      "canonicalization_requirements",
      "purpose_phase_mode",
      "compatibility_constraints",
      "source_ownership_and_reference_requirements",
      "authority_references_and_non_authoritative_asserted_action",
      "required_capabilities_and_reasoning_class",
      "validation_profile_and_validator_requirements",
      "hydrator_adapter_renderer_requirements",
      "ordered_transport_policy",
      "required_outputs_and_expected_evidence",
      "mandatory_fail_closed_conditions"
    ],
    "contract_must_not_include": [
      "contract_digest",
      "selected_source_manifest_digest",
      "hydrated_context_digest",
      "rendered_prompt_digest",
      "actual_transport_selection",
      "validation_results",
      "execution_results",
      "checkpoint_output",
      "runtime_safety_policy_identity"
    ],
    "receipt_is_append_only": true,
    "receipt_references_contract_digest": true,
    "receipt_records_selected_and_derived_identities": true
  },
  "fresh_selection_rules": {
    "immutable_for_attempt": [
      "selected_source_blobs",
      "hydrator",
      "representation_adapter",
      "renderer",
      "validation_profile",
      "validator_identity",
      "model_recommendation_metadata",
      "transport_policy_inputs"
    ],
    "no_input_moves_during_attempt": true,
    "select_once_before_hydration": true
  },
  "invariants": {
    "no_authority": true,
    "no_orchestration": true,
    "no_state_transition": true,
    "prompt_text_is_not_authorization": true,
    "validation_is_not_authorization": true
  },
  "mandatory_fail_closed_triggers": [
    "missing_required_identity_or_evidence",
    "contract_receipt_boundary_violation",
    "derived_digest_in_contract",
    "digest_or_exact_byte_mismatch",
    "schema_major_mismatch",
    "canonicalization_major_mismatch",
    "invalid_unicode_or_encoding",
    "non_i_json_or_incompatible_number",
    "source_missing_stale_ambiguous_duplicate_conflicting_or_out_of_range",
    "validator_profile_or_checkpoint_lineage_mismatch",
    "replay_dependency_unavailable_or_selection_drift",
    "mandatory_executor_capability_unavailable",
    "live_authority_stale_consumed_expired_revoked_ambiguous_or_mismatched",
    "transport_changes_bytes_or_weakens_invariants",
    "lifecycle_mutation_authorization_or_orchestration_attempt",
    "deterministic_derivation_disagreement"
  ],
  "ownership_precedence": [
    "current_system_and_human_safety_constraints",
    "human_intent_task_ledger_and_explicit_authorization",
    "durable_lifecycle_state_accepted_identities_and_live_authority",
    "shared_playbook_semantics",
    "repository_local_instructions_and_sources",
    "bounded_phase_profile",
    "representation_adapter",
    "renderer",
    "transport"
  ],
  "reasoning_classes": [
    "light",
    "medium",
    "high"
  ],
  "required_identity_names": [
    "schema_version",
    "canonicalization_scheme",
    "canonicalization_version",
    "semantic_prompt_contract",
    "validation_profile",
    "validator_identity",
    "source_manifest",
    "authority_source_and_durable_lineage",
    "hydrator",
    "hydrated_context",
    "representation_adapter",
    "renderer",
    "rendered_prompt",
    "transport_policy",
    "transport_selection",
    "attempt",
    "checkpoint",
    "runtime_safety_policy_observation"
  ],
  "rendered_prompt_bytes": {
    "canonicalization": "not-jcs",
    "digest_algorithm": "SHA-256",
    "encoding": "UTF-8",
    "final_newline_rule": "explicitly_declared_by_renderer",
    "line_endings": "LF",
    "no_bom": true
  },
  "replay_pinned_identities": [
    "semantic_contract_digest_and_version",
    "schema_identity",
    "canonicalization_identity",
    "source_bytes_and_references",
    "source_manifest_digest",
    "hydrated_context_digest",
    "hydrator_identity",
    "representation_adapter_identity",
    "renderer_identity",
    "validation_profile",
    "validator_identity",
    "rendered_prompt_bytes",
    "ordered_transport_policy",
    "attempt_and_checkpoint_lineage",
    "durable_state_or_receipt_lineage",
    "authority_source_reference_and_asserted_action"
  ],
  "transport_invariants": {
    "fallback_changes_delivery_only": true,
    "must_preserve": [
      "prompt_bytes",
      "contract_identity",
      "validation",
      "provenance",
      "evidence",
      "authority_handling",
      "required_capabilities"
    ],
    "selection_rule": "first_currently_available_permitted_route_in_declared_order"
  },
  "versioning_categories": {
    "major": [
      "authority",
      "lifecycle",
      "guarantees",
      "replay",
      "compatibility_major",
      "fallback_semantics"
    ],
    "minor": [
      "executor_visible_imperative_instruction_change",
      "new_required_behavior",
      "compatible_semantic_addition"
    ],
    "patch": [
      "strictly_non_behavioral_executor_invisible_change"
    ]
  }
}
