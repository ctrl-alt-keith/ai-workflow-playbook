#!/usr/bin/env python3
"""Run a constrained local Codex review from an explicit executable."""

from __future__ import annotations

import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from review_launcher import Launch, Provider, main, redact  # noqa: E402


LAST_MESSAGE_FILE = "last-message.txt"
# Codex's formatted stderr transcript echoes the model's own text, so only its
# runtime error lines (observed shape: `<timestamp> ERROR <target>: <message>`,
# codex-cli 0.154.0) are eligible for auth-failure classification.
DIAGNOSTIC_LINE = re.compile(r"^\S+\s+ERROR\s")
AUTH_FAILURE = re.compile(
    r"\b(?:"
    r"not logged in|"
    r"codex login|"
    r"failed to authenticate|"
    r"authentication[_ ](?:error|failed)|"
    r"refresh token|"
    r"token (?:has )?expired|"
    r"invalid (?:api[ _-]?key|authentication credentials)|"
    r"401[ :_-]+unauthorized|"
    r"unauthorized"
    r")\b"
)


def require_listed_selector(executable: str, selection: dict[str, str], environment: dict[str, str]) -> None:
    """Reject a selector the runtime's model catalog does not list before any task starts.

    This is a runtime-catalog observation, not proof of acceptance under the
    governed envelope: ``codex debug models`` is undocumented (observed with
    codex-cli 0.154.0 on 2026-09-13), takes no ``--ignore-user-config``, returns
    the account-refreshed catalog when authenticated and silently falls back to
    the binary's bundled catalog otherwise. The governed run's own banner is
    the effective-model evidence. An unreadable catalog fails closed.
    """
    try:
        result = subprocess.run(
            [executable, "debug", "models"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            text=True,
            timeout=60,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ValueError(f"could not read the Codex model catalog: {error}") from error
    try:
        if result.returncode != 0:
            raise ValueError(redact(result.stderr.strip()) or f"exit {result.returncode}")
        catalog = {
            entry["slug"]: [level["effort"] for level in entry.get("supported_reasoning_levels", [])]
            for entry in json.loads(result.stdout)["models"]
        }
    except (KeyError, TypeError, ValueError) as error:
        raise ValueError(f"could not read the Codex model catalog: {error}") from error
    model = selection["model"]
    if model not in catalog:
        raise ValueError(f"the Codex model catalog does not list model selector {model}")
    effort = selection.get("effort")
    if effort is not None and effort not in catalog[model]:
        raise ValueError(f"the Codex model catalog does not list effort {effort} for {model}")


def configured_envelope(selection: dict[str, str], *, preflight: bool) -> dict[str, Any]:
    """Declare the envelope the wrapper configures; codex_arguments() renders it.

    A ``None`` control was not set by the wrapper: the executor default applies
    and is not observed here. Requested model and effort are requests, not the
    effective runtime values.

    Candidate isolation: Codex loads a checkout's project-scoped ``.codex/``
    layers (config, hooks, rules) only for a trusted project, and trust lives
    in the user config that ``--ignore-user-config`` leaves unloaded, so the
    candidate cannot extend the reviewer's surface through its own
    ``.codex/config.toml``. Account-level app connectors are not part of the
    user config and remain exposed unless disabled, so the wrapper disables
    the apps feature and the default app state. ``project_layers_loaded`` is that derivation
    declared, not an observed runtime fact, and it renders no argv of its own;
    ``user_config_loaded`` is the control that renders. Operator-managed
    configuration and read-only sandbox network semantics are not observed, so
    network reach is not established from these controls alone.
    """
    return {
        "requested": {"model": selection["model"], "effort": selection.get("effort")},
        "sandbox": "read-only",
        "approval_policy": "never",
        "user_config_loaded": False,
        "project_layers_loaded": False,
        "ephemeral": True,
        "history_persistence": "none",
        "web_search": "disabled",
        "apps": "disabled",
        "git_repo_check": not preflight,
        "network_access": {
            "granted": None,
            "derived_from": {
                "web_search": "disabled",
                "apps": "disabled",
                "sandbox": "read-only",
                "user_config_loaded": False,
                "project_layers_loaded": False,
                "managed_config": None,
            },
        },
    }


def codex_arguments(envelope: dict[str, Any]) -> list[str]:
    """Render the declared envelope as the Codex argv; command() adds only the run's output path, root, and stdin marker."""
    arguments = ["exec"]
    if not envelope["user_config_loaded"]:
        arguments.append("--ignore-user-config")
    if envelope["ephemeral"]:
        arguments.append("--ephemeral")
    arguments.extend(("--sandbox", envelope["sandbox"], "--color", "never", "--model", envelope["requested"]["model"]))
    if envelope["requested"]["effort"] is not None:
        arguments.extend(("--config", f'model_reasoning_effort="{envelope["requested"]["effort"]}"'))
    for key in ("approval_policy", "web_search"):
        arguments.extend(("--config", f'{key}="{envelope[key]}"'))
    if envelope["apps"] == "disabled":
        # Account-level app connectors are not user config; --ignore-user-config leaves them exposed.
        arguments.extend(("--disable", "apps", "--config", "apps._default.enabled=false"))
    arguments.extend(("--config", f'history.persistence="{envelope["history_persistence"]}"'))
    if not envelope["git_repo_check"]:
        arguments.append("--skip-git-repo-check")
    return arguments


def command(envelope: dict[str, Any], launch: Launch) -> list[str]:
    arguments = [*codex_arguments(envelope), "--output-last-message", str(launch.scratch / LAST_MESSAGE_FILE)]
    if launch.repository is not None:
        arguments.extend(("--cd", launch.repository))
    arguments.append("-")
    return arguments


def diagnostic(stdout: str, stderr: str) -> str:
    return "\n".join(line for line in stderr.splitlines() if DIAGNOSTIC_LINE.match(line))


def output(result: subprocess.CompletedProcess[bytes], launch: Launch) -> str:
    try:
        return (launch.scratch / LAST_MESSAGE_FILE).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


PROVIDER = Provider(
    name="codex",
    label="Codex",
    auth_response="CODEX_AUTH_OK",
    auth_failure=AUTH_FAILURE,
    require_model=True,
    accept=require_listed_selector,
    configured_envelope=configured_envelope,
    command=command,
    output=output,
    output_field="last_message_received",
    diagnostic=diagnostic,
)


if __name__ == "__main__":
    raise SystemExit(main(PROVIDER))
