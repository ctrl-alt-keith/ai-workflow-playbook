#!/usr/bin/env python3
"""Run a constrained local Claude Code review from an explicit executable."""

from __future__ import annotations

import json
from pathlib import Path
import re
import subprocess
import sys
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from review_launcher import Launch, Provider, main  # noqa: E402


LOCAL_READ_ONLY_TOOLS = ("Read", "Grep", "Glob")
AUTH_FAILURE = re.compile(
    r"\b(?:"
    r"failed to authenticate|"
    r"authentication[_ ](?:error|failed)|"
    r"oauth (?:access )?token|"
    r"invalid (?:x-)?api[ _-]?key|"
    r"invalid authentication credentials|"
    r"please run /login|"
    r"401[ :_-]+unauthorized|"
    r"unauthorized"
    r")\b"
)


def configured_envelope(selection: dict[str, str], *, preflight: bool) -> dict[str, Any]:
    """Declare the envelope the wrapper configures; claude_arguments() renders it.

    A ``None`` control was not set by the wrapper: the executor default applies
    and is not observed here. Requested model and effort are requests, not the
    effective runtime values.
    """
    tools = [] if preflight else list(LOCAL_READ_ONLY_TOOLS)
    mcp_config: dict[str, Any] = {"mcpServers": {}}
    # This describes launcher-granted tools, not process-level network isolation.
    network_reaching = {
        "tools_beyond_local_read_only": sorted(set(tools) - set(LOCAL_READ_ONLY_TOOLS)),
        "mcp_servers": sorted(mcp_config["mcpServers"]),
    }
    return {
        "requested": {"model": selection.get("model"), "effort": selection.get("effort")},
        "tools": tools,
        "permission_mode": None if preflight else "dontAsk",
        "strict_mcp_config": True,
        "mcp_config": mcp_config,
        "setting_sources": [],
        "session_persistence": False,
        "slash_commands": None if preflight else False,
        "network_access": {
            "granted": any(network_reaching.values()),
            "derived_from": network_reaching,
            "scope": "launcher_configured_tool_capability",
            "runtime_reach": "unobservable",
        },
        "runtime_effective_selection": "unobservable",
    }


def claude_arguments(envelope: dict[str, Any]) -> list[str]:
    """Render the declared envelope as the Claude argv; nothing else adds flags."""
    arguments: list[str] = []
    for name in ("model", "effort"):
        value = envelope["requested"][name]
        if value is not None:
            arguments.extend((f"--{name}", value))
    arguments.extend(("--tools", ",".join(envelope["tools"])))
    if envelope["permission_mode"] is not None:
        arguments.extend(("--permission-mode", envelope["permission_mode"]))
    if envelope["strict_mcp_config"]:
        arguments.append("--strict-mcp-config")
    arguments.extend(("--mcp-config", json.dumps(envelope["mcp_config"], separators=(",", ":"))))
    arguments.extend(("--setting-sources", ",".join(envelope["setting_sources"])))
    if not envelope["session_persistence"]:
        arguments.append("--no-session-persistence")
    if envelope["slash_commands"] is False:
        arguments.append("--disable-slash-commands")
    if "supplied_evidence" in envelope:
        arguments.extend(("--add-dir", envelope["supplied_evidence"]["path"]))
    return arguments


def command(envelope: dict[str, Any], launch: Launch) -> list[str]:
    return ["-p", *claude_arguments(envelope)]


def output(result: subprocess.CompletedProcess[bytes], launch: Launch) -> bytes:
    return result.stdout


PROVIDER = Provider(
    name="claude",
    label="Claude",
    auth_response="CLAUDE_AUTH_OK",
    auth_failure=AUTH_FAILURE,
    environment={"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1", "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1"},
    configured_envelope=configured_envelope,
    command=command,
    output=output,
    output_field="stdout_received",
    supplied_evidence=True,
)


if __name__ == "__main__":
    raise SystemExit(main(PROVIDER))
