#!/usr/bin/env python3
"""Run a constrained local Claude Code review from an explicit executable."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys
import tempfile
from typing import Any


AUTH_FAILURE_EXIT = 78
REVIEWER_FAILURE_EXIT = 70
AUTH_PREFLIGHT_PROMPT = b"Reply exactly: CLAUDE_AUTH_OK\n"
AUTH_PREFLIGHT_RESPONSE = "CLAUDE_AUTH_OK"
MAX_DIAGNOSTIC_CHARS = 1_000
ALLOWED_OPTIONS = {"--model", "--effort"}


def redact(value: str) -> str:
    """Keep operational diagnostics without retaining obvious credentials."""
    value = value[:MAX_DIAGNOSTIC_CHARS]
    value = re.sub(
        r"(?i)\bauthorization\b\s*[:=]\s*(?:bearer\s+)?[^\s,;]+",
        "authorization=[REDACTED]",
        value,
    )
    value = re.sub(
        r"(?i)\b(token|secret|api[_-]?key|credential|cookie)\b\s*[:=]\s*[^\s,;]+",
        r"\1=[REDACTED]",
        value,
    )
    return value


def parse_claude_options(arguments: list[str]) -> list[str]:
    """Allow only model and effort choices; the wrapper owns review controls."""
    selected: list[str] = []
    seen: set[str] = set()
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        option, separator, inline_value = argument.partition("=")
        if option not in ALLOWED_OPTIONS:
            raise ValueError(f"unsupported Claude option: {argument}")
        if option in seen:
            raise ValueError(f"{option} may be provided only once")
        if separator:
            value = inline_value
        else:
            if index + 1 >= len(arguments):
                raise ValueError(f"{option} requires a value")
            value = arguments[index + 1]
            index += 1
        if not value or value.startswith("-"):
            raise ValueError(f"{option} requires a non-option value")
        selected.extend((option, value))
        seen.add(option)
        index += 1
    return selected


def claude_environment() -> dict[str, str]:
    """Use one coherent effective-account context for every Claude child."""
    account = pwd.getpwuid(os.geteuid())
    environment = os.environ.copy()
    environment.update({"HOME": account.pw_dir, "USER": account.pw_name, "LOGNAME": account.pw_name})
    return environment


def resolve_claude(path_value: str | None, environment: dict[str, str]) -> tuple[str, str]:
    if path_value is None:
        raise ValueError("--claude-bin is required")
    requested = Path(path_value)
    if not requested.is_absolute():
        raise ValueError("--claude-bin must be an absolute path")
    resolved = requested.resolve(strict=True)
    if not resolved.is_file() or not os.access(resolved, os.X_OK):
        raise ValueError("--claude-bin must resolve to an executable file")
    try:
        result = subprocess.run(
            [str(resolved), "--version"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            text=True,
            timeout=5,
            env=environment,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ValueError(f"could not obtain Claude version: {error}") from error
    version = (result.stdout or result.stderr).strip()
    if result.returncode != 0 or not version:
        raise ValueError("the Claude executable did not return a version")
    return str(resolved), redact(version)


def validate_diagnostics_destination(destination: Path | None) -> None:
    if destination is None:
        return
    if not destination.is_absolute() or destination.exists() or destination.is_symlink():
        raise ValueError("--diagnostics-file must be a new absolute path")
    if not destination.parent.is_dir():
        raise ValueError("--diagnostics-file parent must exist")


def diagnostics(record: dict[str, Any], destination: Path | None) -> None:
    encoded = json.dumps(record, sort_keys=True)
    print(f"claude-review diagnostics: {encoded}", file=sys.stderr)
    if destination is None:
        return
    destination.write_text(encoded + "\n", encoding="utf-8")


def failure_is_auth_shaped(stdout: str, stderr: str) -> bool:
    combined = f"{stdout}\n{stderr}".lower()
    return any(marker in combined for marker in ("authentication", "oauth", "unauthorized", "401"))


def claude_arguments(options: list[str], *, preflight: bool) -> list[str]:
    if preflight:
        return [*options, "--tools", "", "--no-session-persistence"]
    return [
        *options,
        "--tools",
        "Read,Grep,Glob",
        "--permission-mode",
        "dontAsk",
        "--strict-mcp-config",
        "--mcp-config",
        '{"mcpServers":{}}',
        "--setting-sources",
        "",
        "--no-session-persistence",
        "--disable-slash-commands",
    ]


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run a constrained Claude review; provide the review prompt on standard input."
    )
    parser.add_argument("--claude-bin")
    parser.add_argument("--auth-preflight", action="store_true")
    parser.add_argument("--diagnostics-file", type=Path)
    parser.add_argument("claude_args", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.claude_args[:1] == ["--"]:
        args.claude_args = args.claude_args[1:]
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_arguments(argv or sys.argv[1:])
    preflight = args.auth_preflight
    try:
        validate_diagnostics_destination(args.diagnostics_file)
    except ValueError as error:
        diagnostics(
            {
                "kind": "claude_review",
                "attempt_kind": "auth_preflight" if preflight else "review",
                "status": "failed",
                "failure": redact(str(error)),
            },
            None,
        )
        return AUTH_FAILURE_EXIT if preflight else REVIEWER_FAILURE_EXIT
    try:
        environment = claude_environment()
        executable, version = resolve_claude(args.claude_bin, environment)
        options = parse_claude_options(args.claude_args)
        prompt = AUTH_PREFLIGHT_PROMPT if preflight else sys.stdin.buffer.read()
        if not preflight and not prompt.strip():
            raise ValueError("review prompt must be supplied on standard input")
    except (OSError, ValueError) as error:
        diagnostics(
            {
                "kind": "claude_review",
                "attempt_kind": "auth_preflight" if preflight else "review",
                "status": "failed",
                "failure": redact(str(error)),
            },
            args.diagnostics_file,
        )
        return AUTH_FAILURE_EXIT if preflight else REVIEWER_FAILURE_EXIT

    command = [executable, "-p", *claude_arguments(options, preflight=preflight)]
    temporary_directory: tempfile.TemporaryDirectory[str] | None = None
    try:
        if preflight:
            temporary_directory = tempfile.TemporaryDirectory(prefix="claude-review-preflight-")
            cwd = temporary_directory.name
        else:
            cwd = os.getcwd()
        result = subprocess.run(
            command,
            input=prompt,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            cwd=cwd,
            env=environment,
        )
    except OSError as error:
        diagnostics(
            {
                "kind": "claude_review",
                "attempt_kind": "auth_preflight" if preflight else "review",
                "status": "failed",
                "claude_version": version,
                "failure": redact(str(error)),
            },
            args.diagnostics_file,
        )
        return AUTH_FAILURE_EXIT if preflight else REVIEWER_FAILURE_EXIT
    finally:
        if temporary_directory is not None:
            temporary_directory.cleanup()

    stdout = result.stdout.decode("utf-8", errors="replace")
    stderr = result.stderr.decode("utf-8", errors="replace")
    if preflight:
        successful = result.returncode == 0 and stdout.strip() == AUTH_PREFLIGHT_RESPONSE
    else:
        successful = result.returncode == 0 and bool(stdout.strip())
    auth_failure = failure_is_auth_shaped(stdout, stderr)
    record = {
        "kind": "claude_review",
        "attempt_kind": "auth_preflight" if preflight else "review",
        "status": "ok" if successful else "failed",
        "claude_version": version,
        "claude_exit_code": result.returncode,
        "stdout_received": bool(stdout.strip()),
        "stderr": redact(stderr),
    }
    if not successful:
        record["failure"] = (
            "Claude authentication needs operator attention"
            if auth_failure or preflight
            else "Claude did not return substantive review output"
        )
        if stdout:
            record["stdout"] = redact(stdout)
    diagnostics(record, args.diagnostics_file)
    if not successful:
        return AUTH_FAILURE_EXIT if preflight else REVIEWER_FAILURE_EXIT
    sys.stdout.write(f"{AUTH_PREFLIGHT_RESPONSE}\n" if preflight else stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
