#!/usr/bin/env sh
# Keep this script POSIX sh compatible; it is intended for prompt preflight use.

set -u

REPO_URL="${REPOSITORY_PREFLIGHT_REPO_URL:-git@github.com:ctrl-alt-keith/ai-workflow-playbook.git}"
SSH_TARGET="${REPOSITORY_PREFLIGHT_GITHUB_SSH_TARGET:-git@github.com}"

pass_check() {
    printf 'PASS %s\n' "$1"
}

info_check() {
    printf 'INFO %s\n' "$1"
}

fail_check() {
    printf 'FAIL %s\n' "$1"
    printf '  Remediation: %s\n' "$2"
    exit 1
}

require_command() {
    command_name="$1"
    remediation="$2"

    if command -v "$command_name" >/dev/null 2>&1; then
        pass_check "$command_name is installed"
        return
    fi

    fail_check "$command_name is installed" "$remediation"
}

if [ "$#" -gt 0 ]; then
    if [ "$#" -ne 2 ] || [ "$1" != "--https-git-read" ]; then
        fail_check "preflight arguments select a supported profile" "Use no arguments for SSH and GitHub CLI readiness, or --https-git-read with an exact GitHub HTTPS repository URL."
    fi

    https_repo="$2"
    case "$https_repo" in
        https://github.com/*) repo_path="${https_repo#https://github.com/}" ;;
        *) repo_path="" ;;
    esac
    case "$repo_path" in
        */*) repo_owner="${repo_path%%/*}"; repo_name="${repo_path#*/}" ;;
        *) repo_owner=""; repo_name="" ;;
    esac
    repo_name="${repo_name%.git}"
    case "$repo_owner" in
        ""|"."|".."|*[!A-Za-z0-9._-]*) repo_owner="" ;;
    esac
    case "$repo_name" in
        ""|"."|".."|*[!A-Za-z0-9._-]*) repo_name="" ;;
    esac
    if [ -z "$repo_owner" ] || [ -z "$repo_name" ]; then
        fail_check "HTTPS Git-read URL is an exact credential-free GitHub repository URL" "Pass https://github.com/OWNER/REPO with optional .git suffix and no user info, query, fragment, or extra path."
    fi
    require_command "git" "Install Git, then rerun this preflight."
    require_command "python3" "Install Python 3, then rerun this preflight."
    if python3 -I -c '
import os
import subprocess
import sys

allowed = ("PATH", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
           "http_proxy", "https_proxy", "no_proxy",
           "SSL_CERT_FILE", "SSL_CERT_DIR", "GIT_SSL_CAINFO", "GIT_SSL_CAPATH")
child = {name: os.environ[name] for name in allowed if name in os.environ}
child.update(GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false",
             GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL="/dev/null")
try:
    result = subprocess.run(
        ["git", "-c", "credential.helper=", "ls-remote", "--exit-code", sys.argv[1], "HEAD"],
        cwd="/", env=child, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
except (OSError, subprocess.TimeoutExpired):
    sys.exit(1)
sys.exit(result.returncode)
' "$https_repo" >/dev/null 2>&1; then
        pass_check "isolated HTTPS Git repository read works with git ls-remote"
        printf 'PASS Isolated HTTPS Git-read preflight complete; anonymous or proxy-routed read only\n'
        exit 0
    fi
    fail_check "isolated HTTPS Git repository read works with git ls-remote" "Resolve anonymous or proxy-routed HTTPS read for the exact repository; this does not test task Git credentials, push, or GitHub API access."
fi

require_command "ssh" "Install OpenSSH client tools, then rerun this preflight."
require_command "gh" "Add GitHub CLI to PATH if already installed, or install it from https://cli.github.com/, then rerun this preflight."
require_command "git" "Install Git, then rerun this preflight."

case "$SSH_TARGET" in
    git@?*) ssh_host="${SSH_TARGET#git@}" ;;
    *) ssh_host="" ;;
esac

case "$REPO_URL" in
    git@?*:*)
        repo_authority="${REPO_URL#git@}"
        repo_host="${repo_authority%%:*}"
        ;;
    *) repo_host="" ;;
esac

if [ -z "$ssh_host" ] || [ -z "$repo_host" ] || [ "$ssh_host" != "$repo_host" ]; then
    fail_check \
        "GitHub SSH target and repository URL use the same host" \
        "Set REPOSITORY_PREFLIGHT_GITHUB_SSH_TARGET and REPOSITORY_PREFLIGHT_REPO_URL to matching git@host values, then rerun this preflight."
fi

pass_check "GitHub SSH target and repository URL use the same host"

if command -v ssh-add >/dev/null 2>&1; then
    ssh_add_output="$(ssh-add -l 2>&1)"
    ssh_add_status="$?"

    if [ "$ssh_add_status" -eq 0 ]; then
        pass_check "ssh-add -l listed identities for diagnostic context"
    else
        case "$ssh_add_output" in
            *"The agent has no identities"*|*"no identities"*)
                info_check "ssh-add -l reported no identities; continuing to GitHub SSH authentication"
                ;;
            *)
                info_check "ssh-add -l was unavailable or inconclusive; continuing to GitHub SSH authentication"
                ;;
        esac
    fi
else
    info_check "ssh-add is unavailable; continuing to GitHub SSH authentication"
fi

ssh_output="$(
    ssh \
        -T \
        -o BatchMode=yes \
        -o StrictHostKeyChecking=yes \
        -o ConnectTimeout=15 \
        "$SSH_TARGET" 2>&1
)"
ssh_status="$?"

case "$ssh_output" in
    "Hi "*"! You've successfully authenticated, but GitHub does not provide shell access.")
        if [ "$ssh_status" -eq 0 ] || [ "$ssh_status" -eq 1 ]; then
            pass_check "GitHub SSH connectivity works via ssh -T $SSH_TARGET"
        else
            fail_check \
                "GitHub SSH connectivity works via ssh -T $SSH_TARGET" \
                "Resolve SSH authentication for GitHub, then rerun ssh -T $SSH_TARGET."
        fi
        ;;
    *)
        fail_check \
            "GitHub SSH connectivity works via ssh -T $SSH_TARGET" \
            "Run ssh -T $SSH_TARGET and resolve the reported GitHub SSH authentication or known_hosts issue."
        ;;
esac

if gh auth status >/dev/null 2>&1; then
    pass_check "gh auth status succeeds"
else
    fail_check \
        "gh auth status succeeds" \
        "Authenticate GitHub CLI with gh auth login, then rerun gh auth status."
fi

if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15" \
    git ls-remote --exit-code "$REPO_URL" HEAD >/dev/null 2>&1; then
    pass_check "playbook repository is reachable with git ls-remote"
else
    fail_check \
        "playbook repository is reachable with git ls-remote" \
        "Confirm GitHub SSH access and repository permission, then rerun git ls-remote $REPO_URL HEAD."
fi

printf 'PASS Repository preflight complete\n'
