#!/usr/bin/env python3
"""Install one exact reviewed Claude launcher and render its user-layer rule."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import shlex
import stat
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
SOURCE_LAUNCHER = ROOT / "scripts" / "claude-review"
RULE_TEMPLATE = ROOT / ".codex" / "rule-templates" / "claude-review.rules"
INSTALLATION_SCHEMA_VERSION = 3
QUALIFICATION_SCHEMA_VERSION = 3
ENTRY_CONTRACT_SCHEMA_VERSION = 2
MAX_ERROR_CHARS = 1_000


def digest(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")


def entry_contract_identity(contract: dict[str, object]) -> str:
    """Return the content identity of execution-relevant immutable inputs."""
    return f"sha256:{digest(canonical(contract))}"


def bounded_redacted(value: str) -> str:
    """Match the launcher's bounded version-identity rendering."""
    redacted = re.sub(
        r"(?i)\bauthorization\b\s*[:=]\s*(?:bearer\s+)?\S+",
        "authorization=[REDACTED]",
        value,
    )
    redacted = re.sub(
        r"(?i)\b(bearer|token|api[_ -]?key|cookie)\b\s*[:=]\s*\S+",
        r"\1=[REDACTED]",
        redacted,
    )
    redacted = re.sub(
        r'''(?i)[A-Za-z_]*(?:auth|cookie|credential|key|secret|token)[A-Za-z_]*["']?\s*[:=]\s*["']?[^\s,"'}]+''',
        "[REDACTED]",
        redacted,
    )
    redacted = re.sub(r"\b(?:sk|gho|ghp)[_-][A-Za-z0-9_=-]+", "[REDACTED]", redacted)
    return redacted[:MAX_ERROR_CHARS]


def git(*arguments: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(ROOT), *arguments],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "Git source identity check failed")
    return result.stdout.strip()


class QualificationRequiredError(ValueError):
    """Signal selector drift without mutating valid qualification state."""

    def __init__(self, message: str, command: str | None = None):
        super().__init__(message)
        self.command = command


def effective_user_home() -> Path:
    """Resolve the account home belonging to the effective user."""
    try:
        home = Path(pwd.getpwuid(os.geteuid()).pw_dir)
    except KeyError as error:
        raise ValueError("effective user has no account home directory") from error
    if not home.is_absolute():
        raise ValueError("effective user account home directory is not absolute")
    try:
        resolved_home = home.resolve(strict=True)
    except OSError as error:
        raise ValueError("effective user account home directory cannot be resolved") from error
    if not resolved_home.is_dir():
        raise ValueError("effective user account home is not a directory")
    return resolved_home


def production_install_root() -> Path:
    """Return the one production publication directory."""
    return effective_user_home() / ".local" / "bin"


def production_active_rule() -> Path:
    """Return the effective user's default active Codex rule path."""
    return effective_user_home() / ".codex" / "rules" / "claude-review.rules"


def exact_executable_file_identity(
    selector: Path, forbidden_roots: list[Path] | None = None
) -> dict[str, object]:
    """Observe exact selector and target bytes without executing the target."""
    if not selector.is_absolute():
        raise ValueError("--claude-bin must be an exact absolute path")
    selector_metadata = selector.lstat()
    resolved = selector.resolve(strict=True)
    metadata = resolved.stat()
    if selector_metadata.st_uid != os.geteuid() or metadata.st_uid != os.geteuid():
        raise ValueError("Claude selector and target must be owned by the effective user")
    mode = stat.S_IMODE(metadata.st_mode)
    if not stat.S_ISREG(metadata.st_mode) or mode & 0o022 or not mode & 0o100:
        raise ValueError("Claude target must be owner-executable and not group/world-writable")
    roots = forbidden_roots or []
    selector_location = selector.parent.resolve(strict=True) / selector.name
    containment = [
        {
            "root": str(root),
            "selector_contained": contained(selector_location, root),
            "resolved_contained": contained(resolved, root),
        }
        for root in roots
    ]
    if any(item["selector_contained"] or item["resolved_contained"] for item in containment):
        raise ValueError("Claude selector and target must be outside every forbidden writable root")
    identity = {
        "requested_selector": str(selector),
        "selector_kind": "symlink" if stat.S_ISLNK(selector_metadata.st_mode) else "file",
        "selector_target": os.readlink(selector) if stat.S_ISLNK(selector_metadata.st_mode) else None,
        "selector_uid": selector_metadata.st_uid,
        "selector_mode": oct(stat.S_IMODE(selector_metadata.st_mode)),
        "selector_device": selector_metadata.st_dev,
        "selector_inode": selector_metadata.st_ino,
        "selector_size": selector_metadata.st_size,
        "resolved_path": str(resolved),
        "resolved_uid": metadata.st_uid,
        "resolved_mode": oct(mode),
        "resolved_regular_file": stat.S_ISREG(metadata.st_mode),
        "resolved_owner_executable": bool(mode & 0o100),
        "resolved_device": metadata.st_dev,
        "resolved_inode": metadata.st_ino,
        "resolved_size": metadata.st_size,
        "resolved_sha256": digest(resolved.read_bytes()),
        "forbidden_root_containment": containment,
    }
    final_metadata = resolved.stat()
    if (
        final_metadata.st_dev != metadata.st_dev
        or final_metadata.st_ino != metadata.st_ino
        or final_metadata.st_size != metadata.st_size
        or digest(resolved.read_bytes()) != identity["resolved_sha256"]
        or any(
            getattr(selector.lstat(), field) != getattr(selector_metadata, field)
            for field in ("st_dev", "st_ino", "st_uid", "st_mode", "st_size")
        )
        or (
            stat.S_ISLNK(selector_metadata.st_mode)
            and os.readlink(selector) != identity["selector_target"]
        )
    ):
        raise ValueError("Claude selector or target changed during identity observation")
    return identity


def qualified_executable_identity(
    selector: Path, forbidden_roots: list[Path] | None = None
) -> dict[str, object]:
    before = exact_executable_file_identity(selector, forbidden_roots)
    version = subprocess.run(
        [str(before["resolved_path"]), "--version"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=5,
        cwd=str(Path(str(before["resolved_path"])).parent),
    )
    exact_version = bounded_redacted((version.stdout or version.stderr).strip())
    if version.returncode != 0 or not exact_version:
        raise ValueError("Claude target did not provide an exact version identity")
    after = exact_executable_file_identity(selector, forbidden_roots)
    if after != before:
        raise ValueError("Claude selector or target changed during version observation")
    return {"file_identity": before, "version": exact_version}


def validate_recorded_file_identity(
    identity: object, selector: str, forbidden_roots: list[str]
) -> None:
    required_keys = {
        "requested_selector", "selector_kind", "selector_target", "selector_uid",
        "selector_mode", "selector_device", "selector_inode", "selector_size",
        "resolved_path", "resolved_uid", "resolved_mode", "resolved_regular_file",
        "resolved_owner_executable", "resolved_device", "resolved_inode",
        "resolved_size", "resolved_sha256", "forbidden_root_containment",
    }
    if not isinstance(identity, dict) or set(identity) != required_keys:
        raise ValueError("existing qualification receipt file identity shape is invalid")
    try:
        selector_mode = int(str(identity["selector_mode"]), 8)
        resolved_mode = int(str(identity["resolved_mode"]), 8)
    except (KeyError, ValueError) as error:
        raise ValueError("existing qualification receipt file identity modes are invalid") from error
    if (
        identity["requested_selector"] != selector
        or identity["selector_kind"] not in {"file", "symlink"}
        or identity["selector_uid"] != os.geteuid()
        or not isinstance(identity["selector_mode"], str)
        or selector_mode < 0
        or not all(
            isinstance(identity[field], int)
            for field in ("selector_device", "selector_inode", "selector_size")
        )
        or not isinstance(identity["resolved_path"], str)
        or not Path(identity["resolved_path"]).is_absolute()
        or identity["resolved_uid"] != os.geteuid()
        or not isinstance(identity["resolved_mode"], str)
        or resolved_mode & 0o022
        or not resolved_mode & 0o100
        or identity["resolved_regular_file"] is not True
        or identity["resolved_owner_executable"] is not True
        or not all(
            isinstance(identity[field], int)
            for field in ("resolved_device", "resolved_inode", "resolved_size")
        )
        or not isinstance(identity["resolved_sha256"], str)
        or len(identity["resolved_sha256"]) != 64
        or any(character not in "0123456789abcdef" for character in identity["resolved_sha256"])
    ):
        raise ValueError("existing qualification receipt file identity values are invalid")
    if identity["selector_kind"] == "symlink":
        if not isinstance(identity["selector_target"], str):
            raise ValueError("existing qualification receipt selector link target is invalid")
    elif identity["selector_target"] is not None:
        raise ValueError("existing qualification receipt file selector has an impossible link target")
    expected_containment = [
        {"root": root, "selector_contained": False, "resolved_contained": False}
        for root in forbidden_roots
    ]
    if identity["forbidden_root_containment"] != expected_containment:
        raise ValueError("existing qualification receipt forbidden-root evidence is invalid")


def contained(path: Path, root: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=True))
    except (OSError, ValueError):
        return False
    return True


def validate_destination(path: Path, forbidden_roots: list[Path]) -> None:
    if not path.is_absolute():
        raise ValueError(f"machine-local destination must be absolute: {path}")
    if any(contained(path, root) or contained(root, path) for root in forbidden_roots):
        raise ValueError(f"machine-local destination overlaps a forbidden writable root: {path}")
    ancestor = path
    while not ancestor.exists():
        ancestor = ancestor.parent
    metadata = ancestor.stat()
    if metadata.st_uid not in {0, os.geteuid()} or stat.S_IMODE(metadata.st_mode) & 0o022:
        raise ValueError(f"destination ancestor is not operator-controlled: {ancestor}")


def exclusive_or_identical(path: Path, payload: bytes, mode: int) -> str:
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    except FileExistsError:
        metadata = path.lstat()
        if (
            path.is_symlink()
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or stat.S_IMODE(metadata.st_mode) != mode
            or path.resolve(strict=True) != path
            or path.read_bytes() != payload
        ):
            raise ValueError(f"existing installed object is not byte-identical: {path}")
        return "existing_identical"
    with os.fdopen(descriptor, "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(path, mode)
    return "created"


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def secure_private_directory(path: Path) -> None:
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) & 0o077
        or path.resolve(strict=True) != path
    ):
        raise ValueError(f"state directory is not exact private operator-controlled state: {path}")


def secure_install_directory(path: Path) -> None:
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) & 0o022
        or path.resolve(strict=True) != path
    ):
        raise ValueError(f"install directory is not exact operator-controlled state: {path}")


def secure_regular_bytes(path: Path, *, mode: int) -> bytes:
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != mode
        or path.resolve(strict=True) != path
    ):
        raise ValueError(f"state object is not an exact private regular file: {path}")
    return path.read_bytes()


def validated_existing_qualification(
    manifest: dict[str, object],
) -> tuple[dict[str, object], dict[str, object], bytes]:
    """Apply the launcher's security invariants to one combined entry record."""
    launcher = Path(str(manifest["installed_launcher_path"]))
    install_directory = Path(str(manifest["installation_directory"]))
    receipt_path = install_directory / f".{launcher.name}.json"
    secure_install_directory(install_directory)
    receipt_bytes = secure_regular_bytes(receipt_path, mode=0o400)
    try:
        receipt = json.loads(receipt_bytes)
    except json.JSONDecodeError as error:
        raise ValueError("existing current qualification receipt is malformed") from error
    if not isinstance(receipt, dict):
        raise ValueError("existing current qualification receipt is malformed")
    required_receipt = {
        "kind": "claude_reviewer_qualification_receipt",
        "schema_version": QUALIFICATION_SCHEMA_VERSION,
        "entry_contract_id": manifest["entry_contract_id"],
        "claude_selector": manifest["claude_selector"],
        "producing_launcher_path": manifest["installed_launcher_path"],
        "producing_launcher_sha256": manifest["installed_launcher_sha256"],
        "authority_semantics": "capability qualification only; grants zero task or review authority",
    }
    forbidden_roots = manifest.get("forbidden_roots")
    if not isinstance(forbidden_roots, list) or not all(isinstance(root, str) for root in forbidden_roots):
        raise ValueError("existing qualification manifest forbidden roots are invalid")
    validate_recorded_file_identity(
        receipt.get("file_identity"), str(manifest["claude_selector"]), forbidden_roots
    )
    if (
        any(receipt.get(key) != value for key, value in required_receipt.items())
        or not isinstance(receipt.get("version"), str)
        or not receipt["version"]
        or len(receipt["version"]) > 1000
    ):
        raise ValueError("existing qualification receipt does not match the entry contract")
    predecessor_sha256 = receipt.get("predecessor_receipt_sha256")
    if predecessor_sha256 is not None and (
        not isinstance(predecessor_sha256, str)
        or len(predecessor_sha256) != 64
        or any(character not in "0123456789abcdef" for character in predecessor_sha256)
        or predecessor_sha256 == digest(receipt_bytes)
    ):
        raise ValueError("existing qualification receipt has invalid predecessor lineage")
    current = {
        "kind": "claude_reviewer_current_selection",
        "schema_version": QUALIFICATION_SCHEMA_VERSION,
        "entry_contract_id": manifest["entry_contract_id"],
        "claude_selector": manifest["claude_selector"],
        "receipt_path": str(receipt_path),
        "receipt_sha256": digest(receipt_bytes),
    }
    return current, receipt, receipt_bytes


def replace_expected(path: Path, payload: bytes, expected_sha256: str | None) -> dict[str, object]:
    prior = None
    if path.exists() or path.is_symlink():
        metadata = path.lstat()
        if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
            raise ValueError("active rule must be a non-symlink regular file")
        prior_bytes = path.read_bytes()
        prior = {"size": len(prior_bytes), "sha256": digest(prior_bytes)}
        if prior_bytes == payload:
            if (
                metadata.st_uid != os.geteuid()
                or stat.S_IMODE(metadata.st_mode) & 0o022
                or path.resolve(strict=True) != path
            ):
                raise ValueError("existing identical active rule is not a safe operator-owned file")
            return {"result": "existing_identical", "prior": prior}
        if expected_sha256 is None or prior["sha256"] != expected_sha256:
            raise ValueError("existing active rule does not match --expected-existing-rule-sha256")
    elif expected_sha256 is not None:
        raise ValueError("an expected active rule identity was supplied but no rule exists")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()
    return {"result": "replaced" if prior else "created", "prior": prior}


def secure_operator_directory(path: Path) -> None:
    """Require an exact user-owned directory with no unsafe write access."""
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) & 0o022
        or path.resolve(strict=True) != path
    ):
        raise ValueError(f"directory is not exact operator-controlled state: {path}")


def identity_without_containment(identity: dict[str, object]) -> dict[str, object]:
    return {
        key: value
        for key, value in identity.items()
        if key != "forbidden_root_containment"
    }


def validate_persisted_forbidden_root(root: Path) -> None:
    """Accept an exact historical root even after its directory is retired."""
    try:
        normalized = root.resolve(strict=False)
    except (OSError, RuntimeError) as error:
        raise ValueError("an operator-supplied forbidden root is ambiguous") from error
    if normalized != root:
        raise ValueError("an operator-supplied forbidden root is no longer exact")


def atomic_replace_exact(
    path: Path,
    expected: bytes,
    replacement: bytes,
    mode: int,
    *,
    final_guard=None,
) -> str:
    """Atomically replace one exact file after a final same-object comparison."""
    secure_operator_directory(path.parent)
    metadata = path.lstat()
    observed = secure_regular_bytes(path, mode=mode)
    if observed != expected:
        raise ValueError(f"state changed before replacement: {path}")
    identity = (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_uid,
        metadata.st_mode,
        metadata.st_size,
    )
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(replacement)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        final_metadata = path.lstat()
        final_identity = (
            final_metadata.st_dev,
            final_metadata.st_ino,
            final_metadata.st_uid,
            final_metadata.st_mode,
            final_metadata.st_size,
        )
        if final_identity != identity or secure_regular_bytes(path, mode=mode) != expected:
            raise ValueError(f"state changed during replacement: {path}")
        if final_guard is not None:
            final_guard()
        os.replace(temporary, path)
        if secure_regular_bytes(path, mode=mode) != replacement:
            raise ValueError(f"replacement did not verify: {path}")
        fsync_directory(path.parent)
    finally:
        if temporary.exists():
            temporary.unlink()
    return "replaced"


@dataclass(frozen=True)
class InstalledReconciliation:
    install_root: Path
    launcher: Path
    record_path: Path
    active_rule: Path
    selector: Path
    predecessor_record: dict[str, object]
    predecessor_record_bytes: bytes
    predecessor_launcher_bytes: bytes
    predecessor_rule_bytes: bytes
    current_launcher_bytes: bytes
    current_rule_bytes: bytes
    current_record: dict[str, object]
    current_record_bytes: bytes
    current_selector_identity: dict[str, object]
    launcher_state: str
    rule_state: str


def validate_record_contract(
    record: dict[str, object], *, launcher: Path, install_root: Path
) -> dict[str, object]:
    """Validate the immutable entry and combined qualification record shape."""
    required_record_fields = {
        "schema_version",
        "entry_contract_id",
        "entry_contract",
        "installed_launcher_path",
        "installed_launcher_sha256",
        "active_rule_path",
        "active_rule_sha256",
        "claude_selector",
        "forbidden_roots",
        "qualification_schema_version",
        "installation_directory",
        "kind",
        "file_identity",
        "version",
        "predecessor_receipt_sha256",
        "producing_launcher_path",
        "producing_launcher_sha256",
        "qualification_event",
        "authority_semantics",
    }
    optional_record_fields = {
        "auth_diagnostics_directory",
        "qualified_at_epoch",
        "reconciliation_provenance",
    }
    if not required_record_fields.issubset(record) or set(record) - (
        required_record_fields | optional_record_fields
    ):
        raise ValueError("installed combined record has an unrecognized shape")
    if record.get("qualification_event") not in {
        "initial_installation",
        "identity_transition",
        "entry_contract_reconciliation",
    }:
        raise ValueError("installed combined record has an unknown qualification event")
    if "qualified_at_epoch" in record and (
        not isinstance(record["qualified_at_epoch"], int)
        or record["qualified_at_epoch"] < 0
    ):
        raise ValueError("installed combined record has an invalid qualification time")
    reconciliation_provenance = record.get("reconciliation_provenance")
    if reconciliation_provenance is not None:
        required_provenance_fields = {
            "schema_version",
            "predecessor_entry_contract_id",
            "predecessor_receipt_sha256",
            "predecessor_launcher_sha256",
            "predecessor_active_rule_sha256",
            "predecessor_rule_template_sha256",
            "source_repository",
            "source_commit",
            "source_remote",
        }
        if (
            not isinstance(reconciliation_provenance, dict)
            or set(reconciliation_provenance) != required_provenance_fields
            or reconciliation_provenance.get("schema_version") != 1
        ):
            raise ValueError("installed reconciliation provenance has an unrecognized shape")
        for field in (
            "predecessor_receipt_sha256",
            "predecessor_launcher_sha256",
            "predecessor_active_rule_sha256",
            "predecessor_rule_template_sha256",
        ):
            value = reconciliation_provenance.get(field)
            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                raise ValueError("installed reconciliation provenance has an invalid digest")
        source_commit = reconciliation_provenance.get("source_commit")
        if not isinstance(source_commit, str) or re.fullmatch(
            r"[0-9a-f]{40}", source_commit
        ) is None:
            raise ValueError("installed reconciliation provenance has an invalid commit")
        if not Path(str(reconciliation_provenance.get("source_repository", ""))).is_absolute():
            raise ValueError("installed reconciliation provenance has an invalid source path")
        predecessor_entry_contract_id = reconciliation_provenance.get(
            "predecessor_entry_contract_id"
        )
        if (
            not isinstance(predecessor_entry_contract_id, str)
            or re.fullmatch(r"sha256:[0-9a-f]{64}", predecessor_entry_contract_id) is None
            or reconciliation_provenance.get("predecessor_receipt_sha256")
            != record.get("predecessor_receipt_sha256")
            or not isinstance(reconciliation_provenance.get("source_remote"), str)
            or not reconciliation_provenance["source_remote"]
        ):
            raise ValueError("installed reconciliation provenance does not bind its predecessor")
    contract = record.get("entry_contract")
    if record.get("schema_version") != INSTALLATION_SCHEMA_VERSION:
        raise ValueError("installed launcher schema is not supported managed state")
    if record.get("qualification_schema_version") != QUALIFICATION_SCHEMA_VERSION:
        raise ValueError("installed qualification schema is not supported managed state")
    if not isinstance(contract, dict) or record.get("entry_contract_id") != entry_contract_identity(
        contract
    ):
        raise ValueError("entry-contract identity is invalid")
    required_contract_fields = {
        "entry_contract_schema_version",
        "installation_schema_version",
        "qualification_schema_version",
        "launcher_sha256",
        "rule_template_sha256",
        "claude_selector",
        "active_rule_path",
        "forbidden_roots",
        "installation_directory",
    }
    optional_contract_fields = {"auth_diagnostics_directory"}
    if not required_contract_fields.issubset(contract) or set(contract) - (
        required_contract_fields | optional_contract_fields
    ):
        raise ValueError("entry contract has an unrecognized shape")
    if (
        contract.get("entry_contract_schema_version") != ENTRY_CONTRACT_SCHEMA_VERSION
        or contract.get("installation_schema_version") != INSTALLATION_SCHEMA_VERSION
        or contract.get("qualification_schema_version") != QUALIFICATION_SCHEMA_VERSION
        or record.get("installed_launcher_path") != str(launcher)
        or record.get("installation_directory") != str(install_root)
        or contract.get("installation_directory") != str(install_root)
        or record.get("installed_launcher_sha256") != contract.get("launcher_sha256")
    ):
        raise ValueError("installed record does not bind its exact managed entry")
    for field in ("claude_selector", "active_rule_path", "forbidden_roots"):
        if record.get(field) != contract.get(field):
            raise ValueError(f"installed record diverges from its entry contract at {field}")
    if contract.get("auth_diagnostics_directory") != record.get(
        "auth_diagnostics_directory"
    ):
        raise ValueError("installed record diverges from its entry contract at auth diagnostics")
    for field in ("launcher_sha256", "rule_template_sha256"):
        value = contract.get(field)
        if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
            raise ValueError(f"entry contract has an invalid {field}")
    for field in (
        "installed_launcher_sha256",
        "active_rule_sha256",
        "producing_launcher_sha256",
    ):
        value = record.get(field)
        if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
            raise ValueError(f"installed record has an invalid {field}")
    predecessor_receipt_sha256 = record.get("predecessor_receipt_sha256")
    if predecessor_receipt_sha256 is not None and (
        not isinstance(predecessor_receipt_sha256, str)
        or re.fullmatch(r"[0-9a-f]{64}", predecessor_receipt_sha256) is None
    ):
        raise ValueError("installed record has an invalid predecessor receipt identity")
    if record["producing_launcher_sha256"] != record["installed_launcher_sha256"]:
        raise ValueError("installed record producer does not match its managed launcher")
    active_rule = Path(str(record.get("active_rule_path", "")))
    selector = Path(str(record.get("claude_selector", "")))
    forbidden_roots = record.get("forbidden_roots")
    if (
        not active_rule.is_absolute()
        or not selector.is_absolute()
        or not isinstance(forbidden_roots, list)
        or not forbidden_roots
        or not all(isinstance(root, str) and Path(root).is_absolute() for root in forbidden_roots)
    ):
        raise ValueError("installed record paths are not exact absolute paths")
    for forbidden_root in (Path(str(root)) for root in forbidden_roots):
        if any(
            contained(protected, forbidden_root) or contained(forbidden_root, protected)
            for protected in (install_root, active_rule, selector)
        ):
            raise ValueError("installed state overlaps a forbidden writable root")
    for extra_root in forbidden_roots[1:]:
        validate_persisted_forbidden_root(Path(extra_root))
    auth_diagnostics = record.get("auth_diagnostics_directory")
    if auth_diagnostics is not None:
        diagnostics = Path(str(auth_diagnostics))
        if not diagnostics.is_absolute():
            raise ValueError("installed auth diagnostics path is not exact")
        secure_private_directory(diagnostics)
    return contract


def prepare_installed_reconciliation() -> InstalledReconciliation:
    """Freeze and validate one exact predecessor or resumable partial state."""
    install_root = production_install_root().resolve(strict=True)
    secure_install_directory(install_root)
    launcher = install_root / "claude-review"
    record_path = install_root / ".claude-review.json"
    record_bytes = secure_regular_bytes(record_path, mode=0o400)
    if canonical(json.loads(record_bytes)) != record_bytes:
        raise ValueError("installed combined record is not canonical JSON")
    record = json.loads(record_bytes)
    if not isinstance(record, dict):
        raise ValueError("installed combined record is malformed")
    contract = validate_record_contract(record, launcher=launcher, install_root=install_root)
    _, qualification, _ = validated_existing_qualification(record)
    active_rule = Path(str(record["active_rule_path"]))
    secure_operator_directory(active_rule.parent)
    launcher_bytes = secure_regular_bytes(launcher, mode=0o500)
    active_rule_bytes = secure_regular_bytes(active_rule, mode=0o600)
    current_launcher = SOURCE_LAUNCHER.read_bytes()
    current_rule = RULE_TEMPLATE.read_text(encoding="utf-8").replace(
        "__CLAUDE_REVIEW_LAUNCHER__", str(launcher)
    ).encode("utf-8")
    predecessor_launcher_sha256 = str(record["installed_launcher_sha256"])
    predecessor_rule_sha256 = str(record["active_rule_sha256"])
    launcher_state = (
        "predecessor"
        if digest(launcher_bytes) == predecessor_launcher_sha256
        else "current" if launcher_bytes == current_launcher else "unknown"
    )
    rule_state = (
        "predecessor"
        if digest(active_rule_bytes) == predecessor_rule_sha256
        else "current" if active_rule_bytes == current_rule else "unknown"
    )
    if launcher_state == "unknown":
        raise ValueError("installed launcher is neither the exact predecessor nor current source")
    if rule_state == "unknown":
        raise ValueError("active rule is neither the exact predecessor nor current source")
    if launcher_state == "current" and rule_state == "predecessor":
        raise ValueError("installed objects are not a recognized resumable partial state")

    old_roots = [Path(str(root)) for root in record["forbidden_roots"]]
    selector = Path(str(record["claude_selector"]))
    observed_old_identity = exact_executable_file_identity(selector, old_roots)
    if observed_old_identity != qualification["file_identity"]:
        qualification_command = None
        if launcher_state == "predecessor":
            qualification_command = shlex.join(
                [
                    str(launcher),
                    "--qualify-claude-identity",
                    "--expected-current-receipt-sha256",
                    digest(record_bytes),
                    "--expected-observed-file-identity-sha256",
                    digest(canonical(observed_old_identity)),
                ]
            )
        raise QualificationRequiredError(
            "qualification required before reconciliation: the configured Claude selector changed",
            qualification_command,
        )
    current_roots = [ROOT, *old_roots[1:]]
    current_identity = exact_executable_file_identity(selector, current_roots)
    if identity_without_containment(current_identity) != identity_without_containment(
        qualification["file_identity"]
    ):
        raise QualificationRequiredError(
            "qualification required before reconciliation: the configured Claude identity changed"
        )

    launcher_sha256 = digest(current_launcher)
    rule_template_sha256 = digest(RULE_TEMPLATE.read_bytes())
    current_contract = {
        "entry_contract_schema_version": ENTRY_CONTRACT_SCHEMA_VERSION,
        "installation_schema_version": INSTALLATION_SCHEMA_VERSION,
        "qualification_schema_version": QUALIFICATION_SCHEMA_VERSION,
        "launcher_sha256": launcher_sha256,
        "rule_template_sha256": rule_template_sha256,
        "claude_selector": str(selector),
        "active_rule_path": str(active_rule),
        "forbidden_roots": [str(root) for root in current_roots],
        "installation_directory": str(install_root),
    }
    source_commit = git("rev-parse", "HEAD")
    source_remote = git("remote", "get-url", "origin")
    current_record = {
        "schema_version": INSTALLATION_SCHEMA_VERSION,
        "entry_contract_id": entry_contract_identity(current_contract),
        "entry_contract": current_contract,
        "installed_launcher_path": str(launcher),
        "installed_launcher_sha256": launcher_sha256,
        "active_rule_path": str(active_rule),
        "active_rule_sha256": digest(current_rule),
        "claude_selector": str(selector),
        "forbidden_roots": [str(root) for root in current_roots],
        "qualification_schema_version": QUALIFICATION_SCHEMA_VERSION,
        "installation_directory": str(install_root),
        "kind": "claude_reviewer_qualification_receipt",
        "file_identity": current_identity,
        "version": qualification["version"],
        "predecessor_receipt_sha256": digest(record_bytes),
        "producing_launcher_path": str(launcher),
        "producing_launcher_sha256": launcher_sha256,
        "qualification_event": "entry_contract_reconciliation",
        "authority_semantics": "capability qualification only; grants zero task or review authority",
        "reconciliation_provenance": {
            "schema_version": 1,
            "predecessor_entry_contract_id": record["entry_contract_id"],
            "predecessor_receipt_sha256": digest(record_bytes),
            "predecessor_launcher_sha256": predecessor_launcher_sha256,
            "predecessor_active_rule_sha256": predecessor_rule_sha256,
            "predecessor_rule_template_sha256": contract["rule_template_sha256"],
            "source_repository": str(ROOT),
            "source_commit": source_commit,
            "source_remote": source_remote,
        },
    }
    if "qualified_at_epoch" in qualification:
        current_record["qualified_at_epoch"] = qualification["qualified_at_epoch"]
    return InstalledReconciliation(
        install_root=install_root,
        launcher=launcher,
        record_path=record_path,
        active_rule=active_rule,
        selector=selector,
        predecessor_record=record,
        predecessor_record_bytes=record_bytes,
        predecessor_launcher_bytes=launcher_bytes,
        predecessor_rule_bytes=active_rule_bytes,
        current_launcher_bytes=current_launcher,
        current_rule_bytes=current_rule,
        current_record=current_record,
        current_record_bytes=canonical(current_record),
        current_selector_identity=current_identity,
        launcher_state=launcher_state,
        rule_state=rule_state,
    )


def current_projection_record() -> tuple[dict[str, object], bytes]:
    """Verify the complete installed projection against current source."""
    install_root = production_install_root().resolve(strict=True)
    secure_install_directory(install_root)
    launcher = install_root / "claude-review"
    record_path = install_root / ".claude-review.json"
    launcher_bytes = secure_regular_bytes(launcher, mode=0o500)
    record_bytes = secure_regular_bytes(record_path, mode=0o400)
    try:
        record = json.loads(record_bytes)
    except json.JSONDecodeError as error:
        raise ValueError("installed combined record is malformed") from error
    if not isinstance(record, dict) or canonical(record) != record_bytes:
        raise ValueError("installed combined record is not exact canonical JSON")
    contract = validate_record_contract(record, launcher=launcher, install_root=install_root)
    current_launcher = SOURCE_LAUNCHER.read_bytes()
    current_rule_template = RULE_TEMPLATE.read_bytes()
    active_rule = Path(str(record["active_rule_path"]))
    current_rule = current_rule_template.decode("utf-8").replace(
        "__CLAUDE_REVIEW_LAUNCHER__", str(launcher)
    ).encode("utf-8")
    expected_contract = {
        "entry_contract_schema_version": ENTRY_CONTRACT_SCHEMA_VERSION,
        "installation_schema_version": INSTALLATION_SCHEMA_VERSION,
        "qualification_schema_version": QUALIFICATION_SCHEMA_VERSION,
        "launcher_sha256": digest(current_launcher),
        "rule_template_sha256": digest(current_rule_template),
        "claude_selector": record["claude_selector"],
        "active_rule_path": str(active_rule),
        "forbidden_roots": record["forbidden_roots"],
        "installation_directory": str(install_root),
    }
    if record.get("auth_diagnostics_directory") is not None:
        expected_contract["auth_diagnostics_directory"] = record[
            "auth_diagnostics_directory"
        ]
    if (
        contract != expected_contract
        or record.get("installed_launcher_sha256") != digest(current_launcher)
        or launcher_bytes != current_launcher
        or record.get("active_rule_sha256") != digest(current_rule)
        or secure_regular_bytes(active_rule, mode=0o600) != current_rule
    ):
        raise ValueError("installed projection does not match current reviewed source")
    _, qualification, _ = validated_existing_qualification(record)
    roots = [Path(str(root)) for root in record["forbidden_roots"]]
    observed = exact_executable_file_identity(Path(str(record["claude_selector"])), roots)
    if observed != qualification["file_identity"]:
        command = shlex.join(
            [
                str(launcher),
                "--qualify-claude-identity",
                "--expected-current-receipt-sha256",
                digest(record_bytes),
                "--expected-observed-file-identity-sha256",
                digest(canonical(observed)),
            ]
        )
        raise QualificationRequiredError(
            "configured Claude selector differs from the current qualification", command
        )
    return record, record_bytes


def reconcile_installed_projection() -> dict[str, object]:
    """Apply or resume one exact component-owned managed projection update."""
    status = git("status", "--porcelain=v1", "--untracked-files=all")
    if status:
        raise RuntimeError("reviewed source repository must be completely clean before reconciliation")
    install_root = production_install_root()
    launcher = install_root / "claude-review"
    record_path = install_root / ".claude-review.json"
    if (
        not launcher.exists()
        and not launcher.is_symlink()
        and not record_path.exists()
        and not record_path.is_symlink()
    ):
        return {"kind": "claude_review_reconciliation", "result": "not_installed"}
    try:
        current, current_bytes = current_projection_record()
    except QualificationRequiredError:
        raise
    except (OSError, ValueError, KeyError, TypeError):
        current = None
        current_bytes = None
    if current is not None and current_bytes is not None:
        return {
            "kind": "claude_review_reconciliation",
            "result": "existing_current",
            "installation_manifest_sha256": digest(current_bytes),
        }

    reconciliation = prepare_installed_reconciliation()
    predecessor_sha256 = digest(reconciliation.predecessor_record_bytes)
    roots = [Path(str(root)) for root in reconciliation.current_record["forbidden_roots"]]

    launcher_result = "existing_current" if reconciliation.launcher_state == "current" else "pending"
    rule_result = "existing_current" if reconciliation.rule_state == "current" else "pending"
    if reconciliation.rule_state == "predecessor":
        if secure_regular_bytes(reconciliation.record_path, mode=0o400) != reconciliation.predecessor_record_bytes:
            raise ValueError("installed record changed before active-rule replacement")
        rule_result = atomic_replace_exact(
            reconciliation.active_rule,
            reconciliation.predecessor_rule_bytes,
            reconciliation.current_rule_bytes,
            0o600,
        )
    if reconciliation.launcher_state == "predecessor":
        if secure_regular_bytes(reconciliation.record_path, mode=0o400) != reconciliation.predecessor_record_bytes:
            raise ValueError("installed record changed before launcher replacement")
        if secure_regular_bytes(reconciliation.active_rule, mode=0o600) != reconciliation.current_rule_bytes:
            raise ValueError("active rule changed before launcher replacement")
        launcher_result = atomic_replace_exact(
            reconciliation.launcher,
            reconciliation.predecessor_launcher_bytes,
            reconciliation.current_launcher_bytes,
            0o500,
        )
    if secure_regular_bytes(reconciliation.record_path, mode=0o400) != reconciliation.predecessor_record_bytes:
        raise ValueError("installed record changed before final record replacement")
    if secure_regular_bytes(reconciliation.launcher, mode=0o500) != reconciliation.current_launcher_bytes:
        raise ValueError("launcher changed before final record replacement")
    if secure_regular_bytes(reconciliation.active_rule, mode=0o600) != reconciliation.current_rule_bytes:
        raise ValueError("active rule changed before final record replacement")
    if exact_executable_file_identity(reconciliation.selector, roots) != reconciliation.current_selector_identity:
        raise ValueError("Claude selector changed before final record replacement")

    def final_record_guard() -> None:
        if secure_regular_bytes(reconciliation.launcher, mode=0o500) != reconciliation.current_launcher_bytes:
            raise ValueError("launcher changed during final record replacement")
        if secure_regular_bytes(reconciliation.active_rule, mode=0o600) != reconciliation.current_rule_bytes:
            raise ValueError("active rule changed during final record replacement")
        if exact_executable_file_identity(reconciliation.selector, roots) != reconciliation.current_selector_identity:
            raise ValueError("Claude selector changed during final record replacement")

    record_result = atomic_replace_exact(
        reconciliation.record_path,
        reconciliation.predecessor_record_bytes,
        reconciliation.current_record_bytes,
        0o400,
        final_guard=final_record_guard,
    )
    verified, verified_bytes = current_projection_record()
    if verified != reconciliation.current_record or verified_bytes != reconciliation.current_record_bytes:
        raise ValueError("complete reconciled projection did not verify")
    return {
        "kind": "claude_review_reconciliation",
        "result": "verified",
        "predecessor_manifest_sha256": predecessor_sha256,
        "installation_manifest_sha256": digest(verified_bytes),
        "active_rule_result": rule_result,
        "launcher_result": launcher_result,
        "manifest_result": record_result,
    }


@dataclass(frozen=True)
class InstalledProjectionPlan:
    """Read-only status, evidence, and component-owned recovery guidance."""

    state: str
    summary: str
    findings: tuple[str, ...]
    required_actions: tuple[str, ...]
    commands: tuple[str, ...] = ()
    requirements: tuple[str, ...] = ()


def installed_projection_plan() -> InstalledProjectionPlan:
    """Inspect the production launcher projection without changing local state."""
    install_root = production_install_root()
    launcher = install_root / "claude-review"
    record_path = install_root / ".claude-review.json"

    if (
        not launcher.exists()
        and not launcher.is_symlink()
        and not record_path.exists()
        and not record_path.is_symlink()
    ):
        return InstalledProjectionPlan(
            "SKIP",
            f"claude-review is not installed at {install_root}",
            (),
            (),
        )
    if not launcher.exists() and not launcher.is_symlink():
        return InstalledProjectionPlan(
            "BLOCKED",
            "installed claude-review launcher is missing",
            (),
            ("manual component inspection is required; no aggregate apply is safe",),
        )
    if not record_path.exists() and not record_path.is_symlink():
        return InstalledProjectionPlan(
            "BLOCKED",
            "installed claude-review record is missing",
            (),
            ("manual component inspection is required; no aggregate apply is safe",),
        )
    try:
        current_projection_record()
    except QualificationRequiredError as error:
        commands = (error.command,) if error.command else ()
        return InstalledProjectionPlan(
            "DRIFT",
            f"claude-review qualification must be reconciled at {launcher}",
            (str(error),),
            ("run the exact qualification action, then rerun the component plan",),
            commands,
        )
    except (OSError, ValueError, KeyError, TypeError):
        pass
    else:
        return InstalledProjectionPlan("PASS", f"claude-review is current at {launcher}", (), ())

    try:
        reconciliation = prepare_installed_reconciliation()
    except QualificationRequiredError as error:
        commands = (error.command,) if error.command else ()
        action = (
            "run the exact qualification action, then rerun the component plan"
            if error.command
            else "manual component recovery is required before qualification can resume"
        )
        return InstalledProjectionPlan(
            "DRIFT" if error.command else "BLOCKED",
            f"claude-review qualification must be reconciled at {launcher}",
            (str(error),),
            (action,),
            commands,
        )
    except (OSError, ValueError, KeyError, TypeError, UnicodeDecodeError) as error:
        return InstalledProjectionPlan(
            "BLOCKED",
            f"installed claude-review state is not an internally consistent managed projection: {error}",
            (),
            ("manual component inspection is required; no aggregate apply is safe",),
        )

    try:
        source_status = git("status", "--porcelain=v1", "--untracked-files=all")
    except RuntimeError as error:
        return InstalledProjectionPlan(
            "BLOCKED",
            f"reviewed source identity is unavailable: {error}",
            (),
            ("restore an exact clean repository source before reconciliation",),
        )
    if source_status:
        return InstalledProjectionPlan(
            "BLOCKED",
            "reviewed source repository is not completely clean",
            (),
            ("use a clean reviewed source checkout before reconciliation",),
        )

    record_sha256 = digest(reconciliation.predecessor_record_bytes)
    command = shlex.join(
        [
            str(Path(sys.executable).resolve()),
            str(Path(__file__).resolve()),
            "--reconcile-installed",
        ]
    )
    findings = (
        f"managed predecessor record_sha256={record_sha256}",
        "installed object state "
        f"launcher={reconciliation.launcher_state} rule={reconciliation.rule_state}",
        "qualification will become a successor receipt bound to the current entry contract; "
        "the already-qualified selector identity and version are preserved without executing Claude",
        "replacement order is active rule, launcher, then combined record; each file is compared "
        "again and atomically replaced, while multi-file atomicity is not claimed",
    )
    requirements = (
        "for aggregate apply, run make apply-local; no plan output needs to be parsed or copied",
        "run from this clean reviewed source checkout; the component verifies repository cleanliness before changing state",
        "if a partial failure occurs before the combined record changes, rerun this exact command; only predecessor/current object combinations produced by this order are accepted",
    )
    return InstalledProjectionPlan(
        "DRIFT",
        f"claude-review has an exact managed predecessor at {launcher}",
        findings,
        (),
        (command,),
        requirements,
    )


def check_installed_projection() -> tuple[str, str]:
    """Return the concise status surface used by aggregate apply preflight."""
    plan = installed_projection_plan()
    return plan.state, plan.summary


def render_installed_projection_plan(plan: InstalledProjectionPlan) -> str:
    """Render only the component-owned facts and bounded next actions."""
    if plan.state in {"PASS", "SKIP"}:
        return f"{plan.state} {plan.summary}"
    lines = [f"{plan.state} claude-review: {plan.summary}"]
    lines.extend(f"FACT {finding}" for finding in plan.findings)
    for command in plan.commands:
        lines.extend(("RECONCILE run:", f"  {command}"))
    lines.extend(f"REQUIRES {requirement}" for requirement in plan.requirements)
    lines.extend(f"RECONCILE {action}" for action in plan.required_actions)
    return "\n".join(lines)


def parse_arguments(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--check-installed", action="store_true")
    group.add_argument("--plan-installed", action="store_true")
    group.add_argument("--reconcile-installed", action="store_true")
    parser.add_argument("--claude-bin", type=Path)
    parser.add_argument(
        "--active-rule",
        type=Path,
    )
    parser.add_argument("--activation-receipt", type=Path)
    parser.add_argument("--expected-existing-rule-sha256")
    parser.add_argument("--forbidden-root", action="append", default=[], type=Path)
    return parser.parse_args(argv)


def main() -> int:
    args = parse_arguments()
    if getattr(args, "check_installed", False) or getattr(args, "plan_installed", False):
        if any(
            (
                args.claude_bin,
                getattr(args, "active_rule", None),
                args.activation_receipt,
                args.expected_existing_rule_sha256,
                args.forbidden_root,
            )
        ):
            raise ValueError(
                "--check-installed and --plan-installed do not accept installation arguments"
            )
        try:
            plan = installed_projection_plan()
        except (OSError, ValueError, KeyError, TypeError) as error:
            print(f"BLOCKED claude-review: {error}")
            return 1
        if getattr(args, "plan_installed", False):
            print(render_installed_projection_plan(plan))
            return 1 if plan.state == "BLOCKED" else 0
        print(f"{plan.state} claude-review: {plan.summary}")
        return 0 if plan.state in {"PASS", "SKIP"} else 1
    if getattr(args, "reconcile_installed", False):
        if any(
            (
                args.claude_bin,
                getattr(args, "active_rule", None),
                args.activation_receipt,
                args.expected_existing_rule_sha256,
                args.forbidden_root,
            )
        ):
            raise ValueError(
                "--reconcile-installed does not accept installation arguments"
            )
        result = reconcile_installed_projection()
        print(json.dumps(result, sort_keys=True))
        return 0
    if args.claude_bin is None or args.activation_receipt is None:
        raise ValueError(
            "--claude-bin and --activation-receipt are required for installation"
        )
    if args.active_rule is None:
        args.active_rule = production_active_rule()
    args.install_root = production_install_root().resolve(strict=False)
    args.active_rule = args.active_rule.parent.resolve(strict=False) / args.active_rule.name
    args.activation_receipt = (
        args.activation_receipt.parent.resolve(strict=False) / args.activation_receipt.name
    )
    if args.activation_receipt.exists() or args.activation_receipt.is_symlink():
        raise ValueError("activation receipt destination must be absent")
    status = git("status", "--porcelain=v1", "--untracked-files=all")
    if status:
        raise RuntimeError("reviewed source repository must be completely clean before installation")
    commit = git("rev-parse", "HEAD")
    source_remote = git("remote", "get-url", "origin")
    launcher_bytes = SOURCE_LAUNCHER.read_bytes()
    launcher_sha256 = digest(launcher_bytes)
    source_rule_sha256 = digest(RULE_TEMPLATE.read_bytes())
    forbidden = [ROOT, *(root.resolve(strict=True) for root in args.forbidden_root)]
    validate_destination(args.install_root, forbidden)
    validate_destination(args.active_rule, forbidden)
    validate_destination(args.activation_receipt, forbidden)
    if args.activation_receipt.parent.exists():
        secure_private_directory(args.activation_receipt.parent)
    initial_file_identity = exact_executable_file_identity(args.claude_bin, forbidden)
    immutable_contract = {
        "entry_contract_schema_version": ENTRY_CONTRACT_SCHEMA_VERSION,
        "installation_schema_version": INSTALLATION_SCHEMA_VERSION,
        "qualification_schema_version": QUALIFICATION_SCHEMA_VERSION,
        "launcher_sha256": launcher_sha256,
        "rule_template_sha256": source_rule_sha256,
        "claude_selector": str(args.claude_bin),
        "active_rule_path": str(args.active_rule),
        "forbidden_roots": [str(root) for root in forbidden],
        "installation_directory": str(args.install_root),
    }
    contract_id = entry_contract_identity(immutable_contract)
    args.activation_receipt.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    secure_private_directory(args.activation_receipt.parent)
    args.install_root.mkdir(parents=True, exist_ok=True, mode=0o755)
    secure_install_directory(args.install_root)
    launcher_name = "claude-review"
    installed_launcher = args.install_root / launcher_name
    rendered_rule = RULE_TEMPLATE.read_text(encoding="utf-8").replace(
        "__CLAUDE_REVIEW_LAUNCHER__", str(installed_launcher)
    ).encode("utf-8")
    active_rule_sha256 = digest(rendered_rule)
    manifest = {
        "schema_version": INSTALLATION_SCHEMA_VERSION,
        "entry_contract_id": contract_id,
        "entry_contract": immutable_contract,
        "installed_launcher_path": str(installed_launcher),
        "installed_launcher_sha256": launcher_sha256,
        "active_rule_path": str(args.active_rule),
        "active_rule_sha256": active_rule_sha256,
        "claude_selector": str(args.claude_bin),
        "forbidden_roots": [str(root) for root in forbidden],
        "qualification_schema_version": QUALIFICATION_SCHEMA_VERSION,
        "installation_directory": str(args.install_root),
    }
    launcher_result = exclusive_or_identical(installed_launcher, launcher_bytes, 0o500)
    manifest_path = args.install_root / f".{launcher_name}.json"
    if manifest_path.exists() or manifest_path.is_symlink():
        manifest_bytes = secure_regular_bytes(manifest_path, mode=0o400)
        try:
            existing_manifest = json.loads(manifest_bytes)
        except json.JSONDecodeError as error:
            raise ValueError("existing combined installation record is malformed") from error
        if not isinstance(existing_manifest, dict) or any(
            existing_manifest.get(key) != value for key, value in manifest.items()
        ):
            raise ValueError("existing combined installation record does not match this entry")
        manifest = existing_manifest
        current_record, current_receipt, _ = validated_existing_qualification(manifest)
        observed_file_identity = exact_executable_file_identity(args.claude_bin, forbidden)
        if current_receipt["file_identity"] != observed_file_identity:
            raise QualificationRequiredError(
                "qualification required: the configured Claude selector no longer matches the valid current receipt"
            )
        manifest_result = "existing_identical"
    else:
        if launcher_result != "created":
            raise ValueError(
                "existing launcher is missing its combined installation and qualification record"
            )
        qualified_identity = qualified_executable_identity(args.claude_bin, forbidden)
        if qualified_identity["file_identity"] != initial_file_identity:
            raise ValueError("Claude selector changed before initial qualification state creation")
        manifest.update({
            "kind": "claude_reviewer_qualification_receipt",
            "file_identity": qualified_identity["file_identity"],
            "version": qualified_identity["version"],
            "predecessor_receipt_sha256": None,
            "producing_launcher_path": str(installed_launcher),
            "producing_launcher_sha256": launcher_sha256,
            "qualification_event": "initial_installation",
            "authority_semantics": "capability qualification only; grants zero task or review authority",
        })
        initial_receipt_bytes = canonical(manifest)
        initial_receipt_sha256 = digest(initial_receipt_bytes)
        manifest_result = exclusive_or_identical(manifest_path, initial_receipt_bytes, 0o400)
        fsync_directory(args.install_root)
        current_record = {
            "kind": "claude_reviewer_current_selection",
            "schema_version": QUALIFICATION_SCHEMA_VERSION,
            "entry_contract_id": contract_id,
            "claude_selector": str(args.claude_bin),
            "receipt_path": str(manifest_path),
            "receipt_sha256": initial_receipt_sha256,
        }
        manifest_bytes = initial_receipt_bytes
    source_provenance = {
        "kind": "claude_review_source_provenance",
        "schema_version": 1,
        "entry_contract_id": contract_id,
        "source_repository": str(ROOT),
        "source_remote": source_remote,
        "source_commit": commit,
        "source_launcher_path": str(SOURCE_LAUNCHER),
        "source_launcher_sha256": launcher_sha256,
        "source_rule_template_path": str(RULE_TEMPLATE),
        "source_rule_template_sha256": source_rule_sha256,
    }
    rule_result = replace_expected(args.active_rule, rendered_rule, args.expected_existing_rule_sha256)
    receipt = {
        **manifest,
        "kind": "claude_review_activation_receipt",
        "source_commit": commit,
        "source_remote": source_remote,
        "source_provenance": source_provenance,
        "installation_manifest_path": str(manifest_path),
        "installation_manifest_sha256": digest(manifest_bytes),
        "launcher_result": launcher_result,
        "manifest_result": manifest_result,
        "active_rule_result": rule_result,
        "qualification_receipt_path": current_record["receipt_path"],
        "qualification_receipt_sha256": current_record["receipt_sha256"],
    }
    exclusive_or_identical(args.activation_receipt, canonical(receipt), 0o600)
    print(json.dumps(receipt, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except QualificationRequiredError as error:
        print(
            json.dumps(
                {
                    "kind": "claude_review_installation",
                    "failure_classification": "reviewer_identity_qualification_required",
                    "error": str(error),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        raise SystemExit(70) from None
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, UnicodeDecodeError) as error:
        print(
            json.dumps(
                {
                    "kind": "claude_review_installation",
                    "failure_classification": "installation_or_reconciliation_blocked",
                    "error": bounded_redacted(str(error)),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        raise SystemExit(1) from None
