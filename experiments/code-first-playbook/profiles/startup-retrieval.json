{
  "operator-sre": [
    {
      "label": "Start a repository task",
      "rule": "pb.startup-floor"
    },
    {
      "label": "Resolve specialized owners",
      "rule": "pb.conditional-activation"
    },
    {
      "label": "Continue or refresh the task",
      "rule": "pb.mode-persistence"
    },
    {
      "label": "Classify source triggers",
      "rule": "pb.retrieval-triggers"
    },
    {
      "label": "Report verification status",
      "rule": "pb.claim-verification"
    },
    {
      "label": "Recover missed retrieval",
      "rule": "pb.retrieval-recovery"
    }
  ],
  "support": [
    {
      "label": "Work began without startup context",
      "rule": "pb.startup-floor"
    },
    {
      "label": "Unsure which guidance applies",
      "rule": "pb.conditional-activation"
    },
    {
      "label": "Follow-up appears to repeat or skip startup",
      "rule": "pb.mode-persistence"
    },
    {
      "label": "A summary is being treated as current state",
      "rule": "pb.retrieval-triggers"
    },
    {
      "label": "A readiness answer has missing evidence",
      "rule": "pb.claim-verification"
    },
    {
      "label": "A source lookup was rejected or never performed",
      "rule": "pb.retrieval-recovery"
    }
  ]
}
